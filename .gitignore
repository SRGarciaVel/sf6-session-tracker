# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem
*.key

# editors
.idea/
*.swp
*.swo
.vscode/*
!.vscode/extensions.json

# debug / logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# worker bundle
/dist

# playwright
/test-results
/playwright-report
/blob-report
/playwright/.cache
# E2E auth state if ever persisted (contains session cookies)
/e2e/.auth

# CFN research (python venv, network dumps, never commit)
/scripts/research/.venv
/debug_output
__pycache__/
*.pyc
# Dedicated research browser profile (normally ~/.sf6-buckler-browser-profile, outside the repo)
.sf6-buckler-browser-profile/

# Built unpacked extension
/apps/companion-extension/dist

# Network captures and browser profiles (may contain Capcom/Buckler session cookies)
*.har
*-browser-profile/
.chromium-profile/
chrome-profile/

# Database dumps
*.dump
*.sql.dump
*.sql.gz
*.backup

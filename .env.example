# ── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgres://sf6:sf6@localhost:5433/sf6_tracker
# Used by integration tests (tests are skipped when unset)
TEST_DATABASE_URL=postgres://sf6:sf6@localhost:5433/sf6_tracker_test

# ── App / auth ─────────────────────────────────────────────────────────────
# Public base URL; used for OBS overlay URLs and auth origin checks.
APP_URL=http://localhost:3000
# 32+ random chars. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-0123456789
# Set to true only behind a trusted reverse proxy (Railway/Fly) so X-Forwarded-For is used.
TRUST_PROXY=false

# ── SF6 data provider ──────────────────────────────────────────────────────
# mock | capcom   (capcom = Buckler prototype, see docs/capcom-provider.md — keep mock by default)
SF6_PROVIDER=mock
PROVIDER_TIMEOUT_MS=10000
# Profile lookups only (match lists are never cached).
PROVIDER_CACHE_TTL_MS=5000
# Capcom prototype (only read when SF6_PROVIDER=capcom). The session file is a Cookie-Editor
# export of a login YOU did in a normal browser; keep it outside the repo. Never automate login.
# CAPCOM_SESSION_FILE=/absolute/path/outside/repo/buckler_session.json
# CAPCOM_BASE_URL=https://www.streetfighter.com/6/buckler
# CAPCOM_MAX_BATTLELOG_PAGES=3
# CAPCOM_BUILD_ID_TTL_MS=1800000
# Dev tools (mock matches, outage simulation). Never enabled in production builds.
ENABLE_DEV_TOOLS=true

# ── Tracker / worker ───────────────────────────────────────────────────────
TRACKER_POLL_INTERVAL_MS=20000
TRACKER_POLL_JITTER_MS=3000
TRACKER_BACKOFF_BASE_MS=30000
TRACKER_BACKOFF_MAX_MS=300000
TRACKER_PROFILE_REFRESH_MS=300000
TRACKER_LEASE_MS=60000
WORKER_TICK_MS=1000
WORKER_CONCURRENCY=10
# Secondary time protection for session membership (primary = baseline match IDs): a NEW match
# counts if played no more than N seconds before "Start session" (coarse/offset CFN timestamps).
SESSION_START_GRACE_SECONDS=90

# ── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=info

{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "types": ["chrome", "node"],
    "paths": {
      "@sf6/capcom-core": ["../../packages/sf6-capcom-core/src/index.ts"],
      "@sf6/capcom-core/*": ["../../packages/sf6-capcom-core/src/*"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "build.mts"]
}
